<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:stretchColumns="1"
    android:padding="8dp">

    <!-- 第一行：Open... -->
    <TableRow android:padding="4dp">
        <TextView
            android:layout_column="1"
            android:text="Open..."
            android:textColor="#D0D0D0"
            android:textSize="16sp" />

        <TextView
            android:gravity="end"
            android:text="Ctrl-O"
            android:textColor="#D0D0D0"
            android:textSize="16sp" />
    </TableRow>

    <!-- 第二行：Save... -->
    <TableRow android:padding="4dp">
        <TextView
            android:layout_column="1"
            android:text="Save..."
            android:textColor="#D0D0D0"
            android:textSize="16sp" />

        <TextView
            android:gravity="end"
            android:text="Ctrl-S"
            android:textColor="#D0D0D0"
            android:textSize="16sp" />
    </TableRow>

    <!-- 第三行：Save As... -->
    <TableRow android:padding="4dp">
        <TextView
            android:layout_column="1"
            android:text="Save As..."
            android:textColor="#D0D0D0"
            android:textSize="16sp" />

        <TextView
            android:gravity="end"
            android:text="Ctrl-Shift-S"
            android:textColor="#D0D0D0"
            android:textSize="16sp" />
    </TableRow>

    <!-- 第一条分割线 -->
    <View
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#555555" />

    <!-- 第四行：X Import... -->
    <TableRow android:padding="4dp">
        <TextView
            android:text="X "
            android:textColor="#D0D0D0"
            android:textSize="16sp"
            android:paddingEnd="8dp" />

        <TextView
            android:text="Import..."
            android:textColor="#D0D0D0"
            android:textSize="16sp" />
    </TableRow>

    <!-- 第五行：X Export... -->
    <TableRow android:padding="4dp">
        <TextView
            android:text="X "
            android:textColor="#D0D0D0"
            android:textSize="16sp"
            android:paddingEnd="8dp" />

        <TextView
            android:text="Export..."
            android:textColor="#D0D0D0"
            android:textSize="16sp" />

        <TextView
            android:gravity="end"
            android:text="Ctrl-E"
            android:textColor="#D0D0D0"
            android:textSize="16sp" />
    </TableRow>

    <!-- 第二条分割线 -->
    <View
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#555555" />

    <!-- 第六行：Quit -->
    <TableRow android:padding="4dp">
        <TextView
            android:layout_column="1"
            android:text="Quit"
            android:textColor="#D0D0D0"
            android:textSize="16sp" />
    </TableRow>

</TableLayout>