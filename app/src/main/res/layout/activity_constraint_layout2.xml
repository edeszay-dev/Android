<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:ignore="HardcodedText,ContentDescription,UseCompoundDrawables">

    <!-- ================= 1. 顶部 Tab 栏 ================= -->
    <View
        android:id="@+id/view_top_bar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#EFEFEF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/tab_station"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/view_top_bar"
        app:layout_constraintBottom_toBottomOf="@id/view_top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tab_flights"
        app:layout_constraintHorizontal_chainStyle="spread">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/space_station_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Space Stations"
            android:textColor="#888888"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_flights"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/view_top_bar"
        app:layout_constraintBottom_toBottomOf="@id/view_top_bar"
        app:layout_constraintStart_toEndOf="@id/tab_station"
        app:layout_constraintEnd_toStartOf="@id/tab_rovers">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/rocket_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flights"
            android:textColor="#333333"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_rovers"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/view_top_bar"
        app:layout_constraintBottom_toBottomOf="@id/view_top_bar"
        app:layout_constraintStart_toEndOf="@id/tab_flights"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/rover_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rovers"
            android:textColor="#888888"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ================= 2. 中间卡片：利用引导线实现完美间隙与覆盖 ================= -->
    <!-- 屏幕正中心的隐藏参考线 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- 左卡片 DCA (左边距设为 40dp，向内缩进) -->
    <TextView
        android:id="@+id/card_dca"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="24dp"
        android:background="#2E6B3E"
        android:gravity="center"
        android:text="DCA"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/view_top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline_center" />

    <!-- 右卡片 MARS -->
    <TextView
        android:id="@+id/card_mars"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="40dp"
        android:background="#2E6B3E"
        android:gravity="center"
        android:text="MARS"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/card_dca"
        app:layout_constraintStart_toEndOf="@id/guideline_center"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 中间白底双向箭头按钮：定位在中心引导线上，利用52dp的宽度自然覆盖20dp的缝隙 -->
    <ImageView
        android:id="@+id/btn_sync"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:elevation="4dp"
        android:src="@drawable/double_arrows"
        app:layout_constraintTop_toTopOf="@id/card_dca"
        app:layout_constraintBottom_toBottomOf="@id/card_dca"
        app:layout_constraintStart_toStartOf="@id/guideline_center"
        app:layout_constraintEnd_toEndOf="@id/guideline_center" />

    <!-- ================= 3. 行程选择条 ================= -->
    <!-- One Way 单程开关栏 (核心修改：左边距20dp贴近屏幕边缘，右边缘绑定DCA右边缘，形成错位长条) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_oneway"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="#B3521E"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/card_dca"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/card_dca">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="One Way"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 开关右侧的圆形指示器 -->
        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@android:drawable/radiobutton_off_background"
            android:backgroundTint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 1 Traveller 旅客选择栏 (与 One Way 左对齐) -->
    <TextView
        android:id="@+id/tv_traveller"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:minWidth="130dp"
        android:background="#B3521E"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="1 Traveller"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        tools:ignore="VisualLintColorContrast"
        app:layout_constraintTop_toBottomOf="@id/layout_oneway"
        app:layout_constraintStart_toStartOf="@id/layout_oneway" />

    <!-- ================= 4. 火星与飞船约束定位 ================= -->
    <ImageView
        android:id="@+id/iv_planet"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:src="@drawable/galaxy"
        app:layout_constraintTop_toBottomOf="@id/tv_traveller"
        app:layout_constraintBottom_toTopOf="@id/btn_depart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 环绕飞船：270度实现正左侧中心对齐 -->
    <ImageView
        android:id="@+id/iv_rocket"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/rocket_icon"
        app:layout_constraintCircle="@id/iv_planet"
        app:layout_constraintCircleAngle="270"
        app:layout_constraintCircleRadius="95dp"
        tools:ignore="MissingConstraints" />

    <!-- ================= 5. 底部紧贴的 DEPART 按钮 ================= -->
    <Button
        android:id="@+id/btn_depart"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="0dp"
        android:backgroundTint="#2E6B3E"
        android:text="DEPART"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>